# Copy to .env; never commit real passwords or keys. Shell exports or Docker --env-file load this file.
ADMIN_PASSWORD=replace-with-a-long-random-password
READER_PASSWORD=replace-with-a-different-long-password
AI_MODE=preview
COOKIE_SECURE=false
DATABASE_PATH=./data/atlas.sqlite3
# Azure: use resource root only, without /openai/v1
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Required for Vercel: a managed PostgreSQL connection string with TLS.
DATABASE_URL=
# Set to the exact deployed origin, for example https://your-app.vercel.app
PUBLIC_ORIGIN=
